### Updated `script.js` (Frontend)
To incorporate Node Material, origami visuals, and backend flexibility, here’s an updated `script.js`:

```javascript
const canvas = document.getElementById("renderCanvas");
const engine = new BABYLON.Engine(canvas, true, { preserveDrawingBuffer: true, stencil: true });

const createScene = async function () {
  const scene = new BABYLON.Scene(engine);
  scene.clearColor = new BABYLON.Color3(0.1, 0.1, 0.2);

  const camera = new BABYLON.ArcRotateCamera("camera", Math.PI / 2, Math.PI / 4, 15, BABYLON.Vector3.Zero(), scene);
  camera.attachControl(canvas, true);
  camera.legendRadiusLimit = 5;
  camera.upperRadiusLimit = 20;

  const light = new BABYLON.HemisphericLight("light", new BABYLON.Vector3(0, 10, 0), scene);

  let knowledgeData = [];
  try {
    const response = await fetch("http://localhost:8080/api/knowledge");
    knowledgeData = await response.json();
  } catch (error) {
    console.error("Failed to fetch knowledge data:", error);
    knowledgeData = [
      { id: "node1", label: "Concept A", position: { x: 3, y: 0, z: 0 }, related: ["node2", "node3"] },
      { id: "node2", label: "Concept B", position: { x: -3, y: 0, z: 0 }, related: ["node1"] },
      { id: "node3", label: "Concept C", position: { x: 0, y: 3, z: 0 }, related: ["node1"] },
    ];
  }

  const centralSphere = BABYLON.MeshBuilder.CreateSphere("central", { diameter: 2, segments: 32 }, scene);
  const nodeMaterial = new BABYLON.NodeMaterial("nodeMat", scene);
  nodeMaterial.loadAsync("https://nme.babylonjs.com/asset/9e9d7a2e-2c3b-4f8e-8f5e-3b3e4a2b1c0d").then(() => {
    nodeMaterial.build();
    centralSphere.material = nodeMaterial;
  }).catch((err) => {
    console.error("Failed to load Node Material:", err);
    const fallbackMaterial = new BABYLON.StandardMaterial("fallbackMat", scene);
    fallbackMaterial.diffuseColor = new BABYLON.Color3(0, 0.58, 0.86);
    centralSphere.material = fallbackMaterial;
  });

  const nodeTemplate = BABYLON.MeshBuilder.CreatePolyhedron("nodeTemplate", { type: 1, size: 0.3 }, scene); // Origami-inspired tetrahedron
  const nodeMaterialTemplate = new BABYLON.StandardMaterial("nodeMat", scene);
  nodeMaterialTemplate.diffuseColor = new BABYLON.Color3(1, 0.5, 0);
  nodeTemplate.material = nodeMaterialTemplate;
  nodeTemplate.isVisible = false;

  const nodes = {};
  const advancedTexture = BABYLON.GUI.AdvancedDynamicTexture.CreateFullscreenUI("UI");
  knowledgeData.forEach((data) => {
    const node = nodeTemplate.createInstance(data.id);
    node.position = new BABYLON.Vector3(data.position.x, data.position.y, data.position.z);
    nodes[data.id] = node;

    node.actionManager = new BABYLON.ActionManager(scene);
    node.actionManager.registerAction(
      new BABYLON.ExecuteCodeAction(BABYLON.ActionManager.OnPickTrigger, () => {
        console.log(`Clicked ${data.label}: ${JSON.stringify(data)}`);
      })
    );
    node.actionManager.registerAction(
      new BABYLON.ExecuteCodeAction(BABYLON.ActionManager.OnPointerOverTrigger, () => {
        const text = new BABYLON.GUI.TextBlock();
        text.text = data.label;
        text.color = "white";
        text.fontSize = 24;
        text.paddingTop = "10px";
        advancedTexture.addControl(text);
        setTimeout(() => advancedTexture.removeControl(text), 2000);
      })
    );
  });

  knowledgeData.forEach((data) => {
    data.related.forEach((relatedId) => {
      const start = nodes[data.id].position;
      const end = nodes[relatedId].position;
      const edge = BABYLON.MeshBuilder.CreateTube(
        `edge_${data.id}_${relatedId}`,
        { path: [start, end], radius: 0.05 },
        scene
      );
      const edgeMaterial = new BABYLON.StandardMaterial(`the edgeMaterial.diffuseColor = new BABYLON.Color3(1, 1, 1);
      edge.material = edgeMaterial;
    });
  });

  scene.registerBeforeRender(() => {
    centralSphere.rotation.y += 0.01;
  });

  return scene;
};

createScene().then((scene) => {
  engine.runRenderLoop(() => {
    scene.render();
  });
});

window.addEventListener("resize", () => {
  engine.resize();
});
