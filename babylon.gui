CSS (`style.css`)
html, body {
  margin: 0;
  padding: 0;
  width: 100%;
  height: 100%;
  overflow: hidden;
}
#renderCanvas {
  width: 100%;
  height: 100%;
  touch-action: none;
}
Purpose: Ensures the canvas is full-screen and responsive, preventing touch interference with Babylon.js controls.
JavaScript (`script.js`)
This script enhances the knowledge sphere with a Node Material for the central sphere, instanced meshes for nodes, and GUI tooltips. It fetches data from a Java backend (or falls back to static JSON).
// Get the canvas
const canvas = document.getElementById("renderCanvas");

// Initialize Babylon.js engine
const engine = new BABYLON.Engine(canvas, true, { preserveDrawingBuffer: true, stencil: true });

// Create the scene
const createScene = async function () {
  const scene = new BABYLON.Scene(engine);
  scene.clearColor = new BABYLON.Color3(0.1, 0.1, 0.2); // Dark blue background

  // Add an ArcRotateCamera
  const camera = new BABYLON.ArcRotateCamera("camera", Math.PI / 2, Math.PI / 4, 15, BABYLON.Vector3.Zero(), scene);
  camera.attachControl(canvas, true);
  camera.lowerRadiusLimit = 5;
  camera.upperRadiusLimit = 20;

  // Add a hemispheric light
  const light = new BABYLON.HemisphericLight("light", new BABYLON.Vector3(0, 10, 0), scene);

  // Fetch knowledge data from Java backend
  let knowledgeData = [];
  try {
    const response = await fetch("http://localhost:8080/api/knowledge");
    knowledgeData = await response.json();
  } catch (error) {
    console.error("Failed to fetch knowledge data:", error);
    knowledgeData = [
      { id: "node1", label: "Concept A", position: { x: 3, y: 0, z: 0 }, related: ["node2", "node3"] },
      { id: "node2", label: "Concept B", position: { x: -3, y: 0, z: 0 }, related: ["node1"] },
      { id: "node3", label: "Concept C", position: { x: 0, y: 3, z: 0 }, related: ["node1"] },
    ];
  }

  // Create central sphere with Node Material
  const centralSphere = BABYLON.MeshBuilder.CreateSphere("central", { diameter: 2, segments: 32 }, scene);
  const nodeMaterial = new BABYLON.NodeMaterial("nodeMat", scene);
  nodeMaterial.loadAsync("https://nme.babylonjs.com/asset/9e9d7a2e-2c3b-4f8e-8f5e-3b3e4a2b1c0d").then(() => {
    nodeMaterial.build();
    centralSphere.material = nodeMaterial;
  }).catch((err) => {
    console.error("Failed to load Node Material:", err);
    const fallbackMaterial = new BABYLON.StandardMaterial("fallbackMat", scene);
    fallbackMaterial.diffuseColor = new BABYLON.Color3(0, 0.58, 0.86);
    centralSphere.material = fallbackMaterial;
  });

  // Create instanced nodes for performance
  const nodeTemplate = BABYLON.MeshBuilder.CreateSphere("nodeTemplate", { diameter: 0.5, segments: 16 }, scene);
  const nodeMaterial = new BABYLON.StandardMaterial("nodeMat", scene);
  nodeMaterial.diffuseColor = new BABYLON.Color3(1, 0.5, 0); // Orange
  nodeTemplate.material = nodeMaterial;
  nodeTemplate.isVisible = false; // Hide template

  const nodes = {};
  const advancedTexture = BABYLON.GUI.AdvancedDynamicTexture.CreateFullscreenUI("UI");
  knowledgeData.forEach((data) => {
    const node = nodeTemplate.createInstance(data.id);
    node.position = new BABYLON.Vector3(data.position.x, data.position.y, data.position.z);
    nodes[data.id] = node;

    // Add interactivity
    node.actionManager = new BABYLON.ActionManager(scene);
    node.actionManager.registerAction(
      new BABYLON.ExecuteCodeAction(BABYLON.ActionManager.OnPickTrigger, () => {
        console.log(`Clicked ${data.label}: ${JSON.stringify(data)}`);
      })
    );
    node.actionManager.registerAction(
      new BABYLON.ExecuteCodeAction(BABYLON.ActionManager.OnPointerOverTrigger, () => {
        const text = new BABYLON.GUI.TextBlock();
        text.text = data.label;
        text.color = "white";
        text.fontSize = 24;
        text.paddingTop = "10px";
        advancedTexture.addControl(text);
        setTimeout(() => advancedTexture.removeControl(text), 2000);
      })
    );
  });

  // Create edges
  knowledgeData.forEach((data) => {
    data.related.forEach((relatedId) => {
      const start = nodes[data.id].position;
      const end = nodes[relatedId].position;
      const edge = BABYLON.MeshBuilder.CreateTube(
        `edge_${data.id}_${relatedId}`,
        { path: [start, end], radius: 0.05 },
        scene
      );
      const edgeMaterial = new BABYLON.StandardMaterial(`edgeMat_${data.id}_${relatedId}`, scene);
      edgeMaterial.diffuseColor = new BABYLON.Color3(1, 1, 1);
      edge.material = edgeMaterial;
    });
  });

  // Animation: Rotate central sphere
  scene.registerBeforeRender(() => {
    centralSphere.rotation.y += 0.01;
  });

  return scene;
};

// Create and render the scene
createScene().then((scene) => {
  engine.runRenderLoop(() => {
    scene.render();
  });
});

// Handle window resize
window.addEventListener("resize", () => {
  engine.resize();
});
What This Does:
	•	Scene Setup: Creates a dark blue scene with an ArcRotateCamera for orbiting and a hemispheric light.
	•	Data Fetching: Attempts to fetch knowledge graph data from a Java backend (http://localhost:8080/api/knowledge) or uses fallback JSON.
	•	Central Sphere: Uses a Node Material (loaded from the Babylon.js Node Material Editor) for a dynamic, glowing effect. Falls back to a standard blue material if loading fails.
	•	Nodes: Uses instanced meshes (via createInstance) for performance, creating orange spheres positioned per the data. Instancing reduces GPU overhead for many nodes.
	•	Edges: Draws white tubes between related nodes.
	•	Interactivity: Clicking nodes logs their data; hovering displays a GUI tooltip with the node’s label for 2 seconds.
	•	Animation: Rotates the central sphere for visual interest.
Node Material:
	•	The Node Material is loaded from a public URL (https://nme.babylonjs.com/asset/...), representing a pre-built glowing effect from the Node Material Editor. You can create your own in the editor (https://nme.babylonjs.com) and export it as JSON.
	•	Example Node Material setup: Combines a gradient texture, time-based animation, and PBR lighting for a pulsating glow.
Java Backend with `java.io`
The backend remains the same as previously described, using java.io to read a JSON file and serve it via a Spring Boot REST API.
Sample JSON (knowledge.json):
[
  {"id": "node1", "label": "Concept A", "position": {"x": 3, "y": 0, "z": 0}, "related": ["node2", "node3"]},
  {"id": "node2", "label": "Concept B", "position": {"x": -3, "y": 0, "z": 0}, "related": ["node1"]},
  {"id": "node3", "label": "Concept C", "position": {"x": 0, "y": 3, "z": 0}, "related": ["node1"]}
]
Java Code (KnowledgeController.java):
import org.springframework.web.bind.annotation.GetMapping;
import org.springframework.web.bind.annotation.RestController;
import java.io.BufferedReader;
import java.io.FileReader;

@RestController
public class KnowledgeController {
    @GetMapping("/api/knowledge")
    public String getKnowledgeData() {
        try {
            BufferedReader reader = new BufferedReader(new FileReader("knowledge.json"));
            StringBuilder json = new StringBuilder();
            String line;
            while ((line = reader.readLine()) != null) {
                json.append(line);
            }
            reader.close();
            return json.toString();
        } catch (Exception e) {
            e.printStackTrace();
            return "[]";
        }
    }
}
Setup:
	•	Run a Spring Boot server on http://localhost:8080.
	•	Place knowledge.json in the project’s root or configure the path.
	•	The endpoint /api/knowledge serves the JSON, which Babylon.js fetches.
Enhancements Specific to “Niner” (Interpreted as Node Material/Node Geometry)
Assuming “niner” relates to Babylon.js’s Node Material or Node Geometry, here’s how they enhance the knowledge sphere:
	1	Node Material for Central Sphere:
	◦	The Node Material adds a shader-based, glowing effect, making the central sphere visually distinct.
	◦	You can customize it in the Node Material Editor (https://nme.babylonjs.com) by combining nodes like Gradient, Time, and PBRMetallicRoughness.
	◦	Example: Add a Sin node to animate color intensity, connected to a FragmentOutput for a pulsating effect.
	2	Node Geometry (Procedural Meshes):
	◦	Babylon.js’s Node Geometry (introduced in 2023, per Babylon.js forum) allows procedural mesh creation, inspired by Blender’s Geometry Nodes.
	◦	Instead of static spheres, you could generate node shapes procedurally (e.g., cubes, icospheres) based on data properties.
	◦	Example: Use Node Geometry to create a complex central mesh (e.g., a faceted sphere) by combining Sphere and Subdivide nodes in the Node Geometry Editor.
	3	Dynamic Node Placement:
	◦	Distribute nodes on the central sphere’s surface using spherical coordinates for a true “sphere” layout: const radius = 3;
	◦	knowledgeData.forEach((data, index) => {
	◦	  const phi = Math.acos(-1 + (2 * index) / knowledgeData.length);
	◦	  const theta = Math.sqrt(knowledgeData.length * Math.PI) * phi;
	◦	  data.position = {
	◦	    x: radius * Math.cos(theta) * Math.sin(phi),
	◦	    y: radius * Math.sin(theta) * Math.sin(phi),
	◦	    z: radius * Math.cos(phi),
	◦	  };
	◦	});
	◦	
	4	Physics for Dynamic Graphs:
	◦	Integrate Cannon.js for physics-based node movement (e.g., nodes attract/repel like a force-directed graph).
	◦	Example: scene.enablePhysics(new BABYLON.Vector3(0, 0, 0), new BABYLON.CannonJSPlugin());
	◦	nodes[data.id].physicsImpostor = new BABYLON.PhysicsImpostor(
	◦	  node,
	◦	  BABYLON.PhysicsImpostor.SphereImpostor,
	◦	  { mass: 1, restitution: 0.9 },
	◦	  scene
	◦	);
	◦	
Comparison with Other Libraries
The web results highlight alternatives like Cytoscape.js, Sigma.js, and NetV.js for graph visualization. Here’s why Babylon.js suits a 3D knowledge sphere:
	•	3D Native: Unlike 2D-focused libraries (e.g., Sigma.js), Babylon.js leverages WebGL for true 3D rendering, ideal for a spherical graph.
	•	Node Material: Offers shader-based visuals not easily achievable in Cytoscape.js or vis.js.
	•	Performance: Instanced meshes and WebGL optimization handle thousands of nodes, though NetV.js may outperform for massive graphs (50,000+ nodes).
	•	Interactivity: Babylon.js’s ActionManager and GUI provide robust click/hover interactions, comparable to Sigma.js’s plugin system.
Addressing `java.io`
As clarified, java.io is used in the Java backend to read knowledge.json. If you meant a different context (e.g., a JavaScript library or data processing), please specify. Alternatives to the backend:
